{
  // Site vitrine de masterofthenight.com.
  // Les pages sont générées par `python3 site/build.py` (template + textes par langue) dans public/<lang>/.
  // src/worker.js choisit la langue à la racine et sert les fichiers statiques pour le reste.
  // Le jeu lui-même est un autre Worker (dépôt motn), servi sur game.masterofthenight.com.
  "name": "masterofthenight-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // Page /stats : le Worker lit la fonction stats_usage() avec la clé PUBLIABLE de Supabase (la même que le jeu,
  // faite pour être publique ; la fonction ne renvoie que des totaux).
  "vars": {
    "SUPABASE_URL": "https://yoosqngbsdyhocdzzwjj.supabase.co",
    "SUPABASE_KEY": "sb_publishable_CUOPeEwliBkkj-jAusxIYQ_cM6LL-y8"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
