{
  // Site vitrine de masterofthenight.com.
  // Les pages sont générées par `python3 site/build.py` (template + textes par langue) dans public/<lang>/.
  // src/worker.js choisit la langue à la racine et sert les fichiers statiques pour le reste.
  // Le jeu lui-même est un autre Worker (dépôt motn), servi sur game.masterofthenight.com.
  "name": "masterofthenight-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
